@* صفحة تعديل فئة في لوحة التحكم *@
@model StoreWebsite.Models.Category

@{
    // عنوان الصفحة الذي يظهر في تبويب المتصفح
    ViewData["Title"] = "تعديل فئة";
}

@* عنوان الصفحة *@
<h1 class="fw-bold mb-4">تعديل فئة</h1>

@* بطاقة النموذج *@
<div class="card shadow-sm">
    <div class="card-body">
        @* نموذج تعديل الفئة *@
        <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" method="post">
            @* رقم الفئة المخفي ليعرف التحكم الفئة المطلوب تعديلها *@
            <input type="hidden" asp-for="Id" />

            @* حقل اسم الفئة *@
            <div class="mb-3">
                @* تسمية الحقل *@
                <label asp-for="Name" class="form-label fw-bold"></label>
                @* حقل إدخال الاسم *@
                <input asp-for="Name" class="form-control" />
                @* رسالة خطأ التحقق *@
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            @* حقل وصف الفئة *@
            <div class="mb-3">
                @* تسمية الحقل *@
                <label asp-for="Description" class="form-label fw-bold"></label>
                @* مساحة كتابة الوصف *@
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            @* حقل رابط صورة الفئة *@
            <div class="mb-3">
                @* تسمية الحقل *@
                <label asp-for="ImageUrl" class="form-label fw-bold">رابط الصورة</label>
                @* حقل إدخال الرابط *@
                <input asp-for="ImageUrl" class="form-control" />
            </div>

            @* أزرار النموذج *@
            <div class="d-flex gap-2">
                @* زر حفظ التعديلات *@
                <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
                @* زر الرجوع للقائمة *@
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>

            @* حماية النموذج من التزوير *@
            @Html.AntiForgeryToken()
        </form>
    </div>
</div>
