@* صفحة قائمة الفئات في لوحة التحكم *@
@model List<StoreWebsite.Models.Category>

@{
    // عنوان الصفحة الذي يظهر في تبويب المتصفح
    ViewData["Title"] = "إدارة الفئات";
}

@* صف العنوان وزر الإضافة *@
<div class="d-flex justify-content-between align-items-center mb-4">
    @* عنوان الصفحة *@
    <h1 class="fw-bold mb-0">إدارة الفئات</h1>
    @* زر إضافة فئة جديدة *@
    <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-primary">+ إضافة فئة</a>
</div>

@* جدول الفئات *@
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                @* رأس الجدول *@
                <thead class="table-light">
                    <tr>
                        <th>الصورة</th>
                        <th>الاسم</th>
                        <th>الوصف</th>
                        <th>عدد المنتجات</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                @* جسم الجدول *@
                <tbody>
                    @* نمر على الفئات *@
                    @foreach (var category in Model)
                    {
                        @* صف كل فئة *@
                        <tr>
                            @* صورة مصغرة للفئة *@
                            <td>
                                <img src="@category.ImageUrl" alt="@category.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
                            </td>
                            @* اسم الفئة *@
                            <td class="fw-bold">@category.Name</td>
                            @* وصف الفئة *@
                            <td>@category.Description</td>
                            @* عدد المنتجات داخل الفئة *@
                            <td>
                                @* نعرض عدد المنتجات في شارة *@
                                <span class="badge bg-primary">@(category.Products?.Count ?? 0)</span>
                            </td>
                            @* أزرار الإجراءات *@
                            <td>
                                @* زر التعديل *@
                                <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                                @* نموذج الحذف المباشر (لا نسمح بالحذف عندما تحتوي الفئة منتجات) *@
                                <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('هل أنت متأكد من حذف هذه الفئة؟');">
                                    @* رقم الفئة المطلوب حذفها *@
                                    <input type="hidden" name="id" value="@category.Id" />
                                    @* زر الحذف *@
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            disabled="@(category.Products != null && category.Products.Any())">حذف</button>
                                    @* حماية النموذج من التزوير *@
                                    @Html.AntiForgeryToken()
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
