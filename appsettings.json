{
  // إعدادات تسجيل الأحداث والتنبيهات
  "Logging": {
    "LogLevel": {
      // مستوى تسجيل الأحداث الافتراضي
      "Default": "Information",
      // مستوى تسجيل أحداث ASP.NET Core (إظهار التحذيرات فقط)
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // السماح بجميع النطاقات للوصول للموقع
  "AllowedHosts": "*",
  // سلسلة الاتصال بقاعدة البيانات
  "ConnectionStrings": {
    // سلسلة الاتصال بخادم SQL Server LocalDB المجاني الموجود على جهازك
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=StoreWebsiteDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  }
}
